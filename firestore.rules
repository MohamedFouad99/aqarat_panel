rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // العقارات: القراءة والكتابة للمستخدمين المسجَّلين فقط (موظفو لوحة التحكم).
    // ملاحظة: الـ WhatsApp Bot هيقرأ عن طريق Admin SDK في Cloud Functions،
    // وده بيتخطّى القواعد دي تلقائياً، فمحتاجش صلاحية قراءة عامة هنا.
    match /properties/{propertyId} {
      allow read, write: if request.auth != null;
    }
  }
}
