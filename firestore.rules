rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // العقارات: القراءة والكتابة للمستخدمين المسجَّلين فقط (موظفو لوحة التحكم).
    // ملاحظة: الـ WhatsApp Bot هيقرأ عن طريق Admin SDK في Cloud Functions،
    // وده بيتخطّى القواعد دي تلقائياً، فمحتاجش صلاحية قراءة عامة هنا.
    match /properties/{propertyId} {
      // القراءة متاحة للجميع (زوار الموقع يتصفحوا العقارات)
      allow read: if true;
      // الإضافة: مسجَّل + ownerId = uid الحالي
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      // التعديل/الحذف: مالك الإعلان فقط (مع توافق رجعي للعقارات القديمة بدون ownerId)
      allow update, delete: if isAdmin() || (request.auth != null
        && (!('ownerId' in resource.data) ||
            resource.data.ownerId == request.auth.uid));
    }

    // البلاغات: أي زائر يقدر يرسل بلاغ (create فقط)،
    // القراءة للمسجَّلين، والمعالجة/الحذف للأدمن فقط.
    match /reports/{reportId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
        && isAdmin();
    }

    // طلبات العقارات: أي زائر يقدر يرسل طلب.
    // القراءة: الطلبات المفتوحة عامة (سوق الطلبات يظهر للزوار بدون تسجيل)،
    // والطلبات المحجوزة/الموجّهة للمسجَّلين فقط.
    match /requests/{requestId} {
      allow create: if true;
      allow read: if request.auth != null || resource.data.status == 'open';
      allow update, delete: if request.auth != null;
    }

    // عدّاد مشاهدات العقارات: قراءة وزيادة متاحة للجميع.
    match /views/{propertyId} {
      allow read, write: if true;
    }

    // طلبات استعارة العروض بين الوسطاء — للمسجَّلين فقط.
    match /borrow_requests/{id} {
      allow read, write: if request.auth != null;
    }

    // سجل الصفقات — للمسجَّلين فقط.
    match /deals/{id} {
      allow read, write: if request.auth != null;
    }

    // إشعارات داخل التطبيق — كل مستخدم يقرأ/يعدّل إشعاراته هو فقط،
    // وأي مسجَّل يقدر يبعت إشعار (toUid مطلوب).
    match /notifications/{id} {
      allow read: if request.auth != null
        && resource.data.toUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.toUid != null;
      allow update, delete: if request.auth != null
        && resource.data.toUid == request.auth.uid;
    }

    // ملف المستخدم (بيانات المعلن): يقرأها الجميع (لعرض ملف المعلن)،
    // ويعدّلها صاحبها، أو الأدمن (توثيق/تغيير دور).
    // الحقول الحسّاسة (role / verified) لا يغيّرها إلا الأدمن،
    // حتى لا يرقّي أي مستخدم نفسه لأدمن أو يوثّق نفسه.
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSelf(userId)
        && request.resource.data.get('role', 'broker') in ['broker', 'owner', 'client']
        && request.resource.data.get('verified', false) == false
      );
      allow update: if isAdmin() || (
        isSelf(userId)
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['role', 'verified'])
      );
      allow delete: if isAdmin();
    }
  }
}
